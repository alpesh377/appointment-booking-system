# Backend environment. Copy to `.env` and adjust.
DATABASE_URL=postgresql+psycopg://abs:abs@localhost:5432/appointment_booking
APP_ORIGIN=http://localhost:3000
JWT_SECRET=change-me-in-production-please-use-a-long-random-value
JWT_TTL_MINUTES=1440
COOKIE_SECURE=false
APP_ENV=development
LOCK_TIMEOUT_MS=5000
SCHEDULING_HORIZON_DAYS=30
BOOKING_NOTICE_HOURS=2
PENDING_HOLD_HOURS=24

# First administrator, used only by `python -m app.seed`.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin-password-123
ADMIN_NAME=Platform Administrator
